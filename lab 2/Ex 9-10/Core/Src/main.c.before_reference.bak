/* Private define ------------------------------------------------------------*/
/* USER CODE BEGIN PD */
#define MAX_LED_MATRIX       8
#define TIMER_CYCLE          1U
#define MATRIX_SCAN_MS       2U
#define MATRIX_SHIFT_MS      200U
#define MATRIX_COLUMN_PINS   (GPIO_PIN_2 | GPIO_PIN_3 | GPIO_PIN_10 | GPIO_PIN_11 | \
                              GPIO_PIN_12 | GPIO_PIN_13 | GPIO_PIN_14 | GPIO_PIN_15)
#define MATRIX_ROW_PINS      (GPIO_PIN_8 | GPIO_PIN_9 | GPIO_PIN_10 | GPIO_PIN_11 | \
                              GPIO_PIN_12 | GPIO_PIN_13 | GPIO_PIN_14 | GPIO_PIN_15)
/* USER CODE END PD */

/* Private macro -------------------------------------------------------------*/
/* USER CODE BEGIN PM */

/* USER CODE END PM */

/* Private variables ---------------------------------------------------------*/
TIM_HandleTypeDef htim2;

/* USER CODE BEGIN PV */
int index_led_matrix = 0;

/* Exercise 9: each byte is one COLUMN, left to right.
 * Bit 0 = ROW0 (top), bit 7 = ROW7 (bottom).
 * ROW0..ROW7 = PB8..PB15, active low in Proteus.
 */
uint8_t matrix_buffer[8] = {0x00, 0x7E, 0x09, 0x09, 0x09, 0x7E, 0x00, 0x00};


/* Shared with TIM2 interrupt. */
volatile uint32_t timer2_counter = 0;
volatile uint32_t timer2_flag = 0;
volatile uint32_t timer_shift_counter = 0;
volatile uint32_t timer_shift_flag = 0;
static uint8_t shift_pending = 0;
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_TIM2_Init(void);
static void MX_GPIO_Init(void);
/* USER CODE BEGIN PFP */
void updateLEDMatrix(int index);
void setTimer2(int duration);
void setTimerShift(int duration);
void timer_run(void);
void shiftLeftMatrixBuffer(void);
/* USER CODE END PFP */

/* Private user code ---------------------------------------------------------*/
/* USER CODE BEGIN 0 */
/* Exercise 9: scan timer. Round up to at least one 1 ms tick. */
void setTimer2(int duration)
{
    uint32_t ticks = (duration > 0) ?
        ((uint32_t)duration + TIMER_CYCLE - 1U) / TIMER_CYCLE : 1U;
    uint32_t saved_primask = __get_PRIMASK();
    __disable_irq();
    timer2_counter = ticks;
    timer2_flag = 0;
    __set_PRIMASK(saved_primask);
}

/* Exercise 10: animation timer, independent of column scanning. */
void setTimerShift(int duration)
{
    uint32_t ticks = (duration > 0) ?
        ((uint32_t)duration + TIMER_CYCLE - 1U) / TIMER_CYCLE : 1U;
    uint32_t saved_primask = __get_PRIMASK();
    __disable_irq();
    timer_shift_counter = ticks;
    timer_shift_flag = 0;
    __set_PRIMASK(saved_primask);
}

void timer_run(void)
{
    if (timer2_counter > 0U) {
        if (--timer2_counter == 0U) timer2_flag = 1;
    }
    if (timer_shift_counter > 0U) {
        if (--timer_shift_counter == 0U) timer_shift_flag = 1;
    }
}

/* Exercise 10: rotate columns left; the departing column re-enters at right. */
void shiftLeftMatrixBuffer(void)
{
    uint8_t first_column = matrix_buffer[0];
    for (int i = 0; i < MAX_LED_MATRIX - 1; i++) {
        matrix_buffer[i] = matrix_buffer[i + 1];
    }
    matrix_buffer[MAX_LED_MATRIX - 1] = first_column;
}
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_TIM2_Init();
  MX_GPIO_Init();
  /* USER CODE BEGIN 2 */
  updateLEDMatrix(0);
  index_led_matrix = 1;
  setTimer2(MATRIX_SCAN_MS);
  setTimerShift(MATRIX_SHIFT_MS);
  __HAL_TIM_SET_COUNTER(&htim2, 0);
  __HAL_TIM_CLEAR_FLAG(&htim2, TIM_FLAG_UPDATE);
  if (HAL_TIM_Base_Start_IT(&htim2) != HAL_OK) {
      Error_Handler();
  }
/* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
      /* Exercise 10: comment only this IF block for a stationary letter A. */
      if (timer_shift_flag == 1U) {
          setTimerShift(MATRIX_SHIFT_MS);
          shift_pending = 1;
      }

      /* Exercise 9: scan all eight columns, one column per timer expiration. */
      if (timer2_flag == 1U) {
          setTimer2(MATRIX_SCAN_MS);
          /* Change the buffer between complete scan frames. */
          if (index_led_matrix == 0 && shift_pending != 0U) {
              shiftLeftMatrixBuffer();
              shift_pending = 0;
          }
          updateLEDMatrix(index_led_matrix);
          index_led_matrix = (index_led_matrix + 1) % MAX_LED_MATRIX;
      }
    
/* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
	  }
  /* USER CODE END 3 */
}

