<mxfile host="Electron"><diagram id="lab3-mode-fsm" name="Mode FSM"><mxGraphModel dx="1704" dy="1013" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="initial" parent="1" style="ellipse;html=1;fillColor=#0F172A;strokeColor=#0F172A;" value="" vertex="1"><mxGeometry height="20" width="20" x="290" y="115" as="geometry"/></mxCell><mxCell id="normal" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;strokeWidth=2;" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;MODE 1 · NORMAL&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:16px;line-height:1.7&quot;&gt;Run the traffic light sequence.&lt;br&gt;Display the countdown for each road&lt;br&gt;using two seven-segment digits per road.&lt;/div&gt;" vertex="1"><mxGeometry height="230" width="400" x="100" y="170" as="geometry"/></mxCell><mxCell id="red" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;strokeWidth=2;" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;MODE 2 · SET RED TIME&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:16px;line-height:1.7&quot;&gt;Blink all red LEDs at 2 Hz.&lt;br&gt;Display mode 02 and the editable duration.&lt;br&gt;Button 2: increase the editable duration.&lt;br&gt;Button 3: save the red duration.&lt;/div&gt;" vertex="1"><mxGeometry height="230" width="400" x="700" y="170" as="geometry"/></mxCell><mxCell id="yellow" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;strokeWidth=2;" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;MODE 3 · SET AMBER TIME&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:16px;line-height:1.7&quot;&gt;Blink all amber LEDs at 2 Hz.&lt;br&gt;Display mode 03 and the editable duration.&lt;br&gt;Button 2: increase the editable duration.&lt;br&gt;Button 3: save the amber duration.&lt;/div&gt;" vertex="1"><mxGeometry height="230" width="400" x="700" y="500" as="geometry"/></mxCell><mxCell id="green" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=22;fontFamily=Arial;strokeWidth=2;" value="&lt;div style=&quot;font-size:20px&quot;&gt;&lt;b&gt;MODE 4 · SET GREEN TIME&lt;/b&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;font-size:16px;line-height:1.7&quot;&gt;Blink all green LEDs at 2 Hz.&lt;br&gt;Display mode 04 and the editable duration.&lt;br&gt;Button 2: increase the editable duration.&lt;br&gt;Button 3: save the green duration.&lt;/div&gt;" vertex="1"><mxGeometry height="230" width="400" x="100" y="500" as="geometry"/></mxCell><mxCell id="start" edge="1" parent="1" source="initial" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="normal" value="Reset"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mode12" edge="1" parent="1" source="normal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="red" value="Button 1 pressed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mode23" edge="1" parent="1" source="red" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=15;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="yellow" value="Button 1 pressed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="mode34" edge="1" parent="1" source="yellow" style="edgeStyle=orthogonalEdg